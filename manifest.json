{
  "manifest_version": 3,
  "name": "AutoVideo 自动刷视频",
  "version": "1.1.5",
  "description": "在抖音、快手、TikTok、Instagram、Facebook 上自动浏览视频：每个视频停留指定秒数后自动切换到下一个。",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": ["storage"],
  "host_permissions": [
    "https://*.douyin.com/*",
    "https://*.kuaishou.com/*",
    "https://*.tiktok.com/*",
    "https://*.instagram.com/*",
    "https://*.facebook.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "AutoVideo 自动刷视频",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.douyin.com/*",
        "https://*.kuaishou.com/*",
        "https://*.tiktok.com/*",
        "https://*.instagram.com/*",
        "https://*.facebook.com/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "commands": {
    "toggle-autoscroll": {
      "suggested_key": {
        "default": "Alt+Shift+A"
      },
      "description": "开始 / 停止自动刷视频"
    }
  }
}
